{
  "manifest_version": 3,
  "name": "Bookmark Startpage",
  "version": "0.1.0",
  "description": "Custom start page powered by your bookmarks",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
